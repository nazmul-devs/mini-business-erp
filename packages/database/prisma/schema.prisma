generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyType {
  VENDOR
  CLIENT
  BOTH
}

enum DocumentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Party {
  id             String     @id @default(cuid())
  name           String
  type           PartyType
  email          String?
  phone          String?
  address        String?
  openingBalance Decimal    @default(0) @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  purchases      Purchase[]
  sales          Sale[]

  @@index([name])
  @@index([type])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String          @unique
  unit           String          @default("pcs")
  purchasePrice  Decimal         @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal         @default(0) @db.Decimal(12, 2)
  currentStock   Decimal         @default(0) @db.Decimal(12, 3)
  lowStockAt     Decimal         @default(0) @db.Decimal(12, 3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([name])
}

model Purchase {
  id            String         @id @default(cuid())
  purchaseNo    String         @unique
  partyId       String
  party         Party          @relation(fields: [partyId], references: [id])
  date          DateTime       @default(now())
  status        DocumentStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PurchaseItem[]

  @@index([partyId, date])
  @@index([status])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
}

model Sale {
  id            String         @id @default(cuid())
  invoiceNo     String         @unique
  partyId       String
  party         Party          @relation(fields: [partyId], references: [id])
  date          DateTime       @default(now())
  status        DocumentStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         SaleItem[]

  @@index([partyId, date])
  @@index([status])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  unitCostAtSale Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, category])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  referenceType String
  referenceId   String
  note          String?
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model BusinessProfile {
  id             String   @id @default(cuid())
  companyName    String
  legalName      String?
  logoUrl        String?
  email          String?
  mobile         String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String   @default("Bangladesh")
  taxNumber      String?
  tradeLicenseNo String?
  currency       String   @default("BDT")
  invoicePrefix  String   @default("INV")
  purchasePrefix String   @default("PUR")
  invoiceFooter  String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}
